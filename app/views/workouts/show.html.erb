<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<main class="tracker-shell min-h-dvh bg-slate-50 px-4 py-6 text-slate-900 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-2xl">
    <nav class="mb-10 flex items-center justify-between gap-4" aria-label="Workout tracker">
      <span class="text-sm font-semibold text-slate-900">Workout tracker</span>
      <%= link_to "History", workout_history_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    </nav>

    <header class="mb-8">
      <p class="mb-2 text-sm font-medium text-slate-500"><%= @date.strftime("%A, %B %-d") %></p>
      <h1 class="text-balance text-3xl font-semibold text-slate-950 sm:text-4xl"><%= @workout ? @workout.fetch(:name) : "Rest day" %></h1>
      <p class="mt-3 text-pretty text-sm leading-6 text-slate-600"><%= @workout ? "Check off each set as you go." : "Take time to recover. Your next checklist will be ready tomorrow." %></p>
    </header>

    <% if @workout %>
      <% total = @workout.fetch(:exercises).sum(&:sets) %>
      <% completed = @completed_sets.size %>
      <div data-controller="checklist"
           data-checklist-url-value="<%= workout_sets_path %>"
           data-checklist-date-value="<%= @date.iso8601 %>">
        <section class="mb-8 rounded-xl border border-slate-200 bg-white p-5" aria-label="Workout progress">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-sm font-semibold text-slate-900">Today's progress</h2>
            <p class="tabular-nums text-sm font-medium text-slate-600" data-checklist-target="progress" aria-live="polite">
              <%= completed == total ? "Workout complete" : "#{completed} of #{total} sets" %>
            </p>
          </div>
          <progress class="workout-progress mt-4 h-2 w-full" value="<%= completed %>" max="<%= total %>" aria-label="Sets completed" data-checklist-target="bar"></progress>
          <p data-checklist-target="error" class="mt-3 text-sm font-medium text-red-700" role="alert" hidden></p>
          <noscript><p class="mt-3 text-sm text-red-700">Enable JavaScript to check off sets.</p></noscript>
        </section>

        <div class="space-y-5">
          <% @workout.fetch(:exercises).each do |exercise| %>
            <fieldset class="min-w-0 rounded-xl border border-slate-200 bg-white px-4 pb-5 pt-3 sm:px-5">
              <legend class="px-1 text-balance text-lg font-semibold text-slate-950"><%= exercise.name %></legend>
              <p class="mb-4 px-1 text-pretty text-sm text-slate-600"><%= exercise.reps %> reps per set</p>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                <% 1.upto(exercise.sets) do |number| %>
                  <label class="set-label flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-800 hover:border-emerald-300">
                    <%= tag.input type: "checkbox",
                          class: "peer sr-only",
                          checked: @completed_sets.include?([exercise.key, number]),
                          disabled: true,
                          aria: { label: "#{exercise.name}, set #{number}" },
                          data: {
                            checklist_target: "checkbox",
                            action: "change->checklist#save",
                            exercise_key: exercise.key,
                            set_number: number
                          } %>
                    <span aria-hidden="true" class="grid size-6 shrink-0 place-items-center rounded-md border-2 border-slate-300 bg-white text-sm font-bold text-transparent peer-checked:border-emerald-700 peer-checked:bg-emerald-700 peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-700">✓</span>
                    <span class="tabular-nums">Set <%= number %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        </div>
      </div>
    <% else %>
      <section class="rounded-xl border border-slate-200 bg-white p-5">
        <h2 class="text-base font-semibold">Recovery day</h2>
        <p class="mt-2 text-pretty text-sm leading-6 text-slate-600">Your checklist starts fresh on the next workout date.</p>
      </section>
    <% end %>
  </div>
</main>
