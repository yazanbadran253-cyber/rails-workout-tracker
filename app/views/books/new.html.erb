<h1>Add a Book</h1>

<% if @book.errors.any? %>
  <p style="color: red"><%= @book.errors.full_messages.join(", ") %></p>
<% end %>

<%= form_with model: @book do |f| %>
  <p><%= f.label :title %><br><%= f.text_field :title %></p>
  <p><%= f.label :author %><br><%= f.text_field :author %></p>
  <p><%= f.label :pages %><br><%= f.number_field :pages %></p>
  <p><%= f.label :read %> <%= f.check_box :read %></p>
  <p><%= f.submit "Save Book" %></p>
<% end %>

<%= link_to "← Back", "/books" %>