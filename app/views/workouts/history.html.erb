<main class="tracker-shell min-h-dvh bg-slate-50 px-4 py-6 text-slate-900 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-2xl">
    <nav class="mb-10 flex items-center justify-between gap-4" aria-label="Workout tracker">
      <span class="text-sm font-semibold text-slate-900">Workout tracker</span>
      <%= link_to "Today", root_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    </nav>

    <header class="mb-8">
      <h1 class="text-balance text-3xl font-semibold text-slate-950 sm:text-4xl">History</h1>
      <p class="mt-3 text-pretty text-sm leading-6 text-slate-600">Workouts appear here when every set is complete.</p>
    </header>

    <% if @completed_workouts.empty? %>
      <section class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-balance text-lg font-semibold">No completed workouts yet</h2>
        <p class="mt-2 text-pretty text-sm leading-6 text-slate-600">Finish every set on a workout day to add your first entry.</p>
        <%= link_to "Back to today", root_path, class: "mt-4 inline-flex min-h-11 items-center rounded-lg bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      </section>
    <% else %>
      <ul class="space-y-3">
        <% @completed_workouts.each do |date, name| %>
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 rounded-xl border border-slate-200 bg-white px-5 py-4">
            <strong class="font-semibold text-slate-950"><%= name %></strong>
            <time class="tabular-nums text-sm text-slate-600" datetime="<%= date.iso8601 %>"><%= date.strftime("%b %-d, %Y") %></time>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</main>
